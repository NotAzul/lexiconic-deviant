<Window x:Class="FenceForge.Views.ForgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FenceForge"
        Width="700"
        Height="670"
        MinWidth="560"
        MinHeight="520"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <Button x:Name="SettingsButton"
              DockPanel.Dock="Right"
              Content="Gemini settings…"
              Click="SettingsClick"
              Margin="10,0,0,0" />
      <StackPanel>
        <TextBlock Text="FenceForge" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Transform the captured clipboard text without changing the clipboard." Foreground="#666" />
      </StackPanel>
    </DockPanel>

    <Expander Grid.Row="1" IsExpanded="True" Margin="0,0,0,10">
      <Expander.Header>
        <TextBlock x:Name="SourceHeader" FontWeight="SemiBold" />
      </Expander.Header>
      <TextBox x:Name="SourceBox"
               Margin="0,7,0,0"
               Height="100"
               IsReadOnly="True"
               AcceptsReturn="True"
               AcceptsTab="True"
               TextWrapping="NoWrap"
               HorizontalScrollBarVisibility="Auto"
               VerticalScrollBarVisibility="Auto" />
    </Expander>

    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Transformation" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
      <ComboBox x:Name="TransformPicker"
                Grid.Column="1"
                DisplayMemberPath="Name"
                SelectionChanged="TransformSelectionChanged">
        <ComboBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}"
                           FontWeight="SemiBold"
                           Foreground="#7A4A21"
                           Margin="5,7,5,3" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ComboBox.GroupStyle>
      </ComboBox>
      <Button x:Name="TransformButton"
              Grid.Column="2"
              Content="Transform"
              Click="TransformClick"
              Margin="10,0,0,0"
              MinWidth="96" />
    </Grid>

    <Border x:Name="CustomPanel"
            Grid.Row="3"
            Visibility="Collapsed"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#E9C7AA"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10"
            Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Custom prompt" FontWeight="SemiBold" Margin="0,0,0,5" />
        <TextBox x:Name="CustomPromptBox"
                 Grid.Row="1"
                 Height="92"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
          <CheckBox x:Name="SaveAsCheckBox"
                    Content="Save As"
                    VerticalAlignment="Center"
                    Checked="SaveAsChanged"
                    Unchecked="SaveAsChanged" />
          <TextBox x:Name="SaveAsNameBox"
                   Width="230"
                   Margin="10,0,0,0"
                   IsEnabled="False"
                   ToolTip="Saved transformation name" />
        </DockPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="4" Margin="0,0,0,8">
      <ProgressBar x:Name="WorkingBar"
                   Height="4"
                   IsIndeterminate="True"
                   Visibility="Collapsed" />
      <TextBlock x:Name="StatusText" Foreground="#666" Margin="0,5,0,0" />
      <TextBlock x:Name="ErrorText"
                 Foreground="#B42318"
                 TextWrapping="Wrap"
                 Margin="0,4,0,0" />
    </StackPanel>

    <TextBlock Grid.Row="5" Text="Result" FontWeight="SemiBold" Margin="0,0,0,5" />
    <TextBox x:Name="ResultBox"
             Grid.Row="6"
             IsEnabled="False"
             AcceptsReturn="True"
             AcceptsTab="True"
             TextWrapping="NoWrap"
             HorizontalScrollBarVisibility="Auto"
             VerticalScrollBarVisibility="Auto"
             SpellCheck.IsEnabled="False" />

    <DockPanel Grid.Row="7" LastChildFill="False" Margin="0,12,0,0">
      <Button x:Name="RetryButton"
              DockPanel.Dock="Left"
              Content="Retry"
              IsEnabled="False"
              Click="RetryClick" />
      <Button x:Name="CancelButton"
              DockPanel.Dock="Right"
              Content="Cancel"
              IsCancel="True"
              Click="CancelClick"
              Margin="8,0,0,0" />
      <Button x:Name="CopyButton"
              DockPanel.Dock="Right"
              Content="Copy"
              IsEnabled="False"
              IsDefault="True"
              Click="CopyClick"
              MinWidth="82" />
    </DockPanel>
  </Grid>
</Window>
