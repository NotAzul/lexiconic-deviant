<Window x:Class="FenceForge.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FenceForge settings"
        Width="520"
        Height="490"
        MinWidth="460"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Gemini"
               FontSize="20"
               FontWeight="SemiBold"
               Margin="0,0,0,12" />

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="130" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" VerticalAlignment="Center" />
      <TextBox x:Name="ModelBox" Grid.Row="0" Grid.Column="1" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="New API key" VerticalAlignment="Center" Margin="0,10,0,0" />
      <PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Padding="7,5" />

      <TextBlock x:Name="ApiKeyStatus" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Foreground="#666" />
    </Grid>

    <Button x:Name="RemoveApiKeyButton"
            Grid.Row="2"
            Content="Remove stored API key"
            HorizontalAlignment="Left"
            Click="RemoveApiKeyClick"
            Margin="130,0,0,14" />

    <GroupBox Grid.Row="3" Header="Saved custom transformations" Margin="0,0,0,14">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox x:Name="CustomTransformsList" DisplayMemberPath="Name" />
        <Button Grid.Row="1"
                Content="Remove selected"
                HorizontalAlignment="Left"
                Margin="0,8,0,0"
                Click="RemoveCustomClick" />
      </Grid>
    </GroupBox>

    <DockPanel Grid.Row="4" LastChildFill="False">
      <TextBlock x:Name="ErrorText"
                 DockPanel.Dock="Left"
                 Foreground="#B42318"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="300" />
      <Button Content="Cancel" DockPanel.Dock="Right" IsCancel="True" Margin="8,0,0,0" />
      <Button Content="Save" DockPanel.Dock="Right" IsDefault="True" Click="SaveClick" />
    </DockPanel>
  </Grid>
</Window>
